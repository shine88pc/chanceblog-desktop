# 이 파일에는 변수 '이름'만 적습니다. 실제 값이 든 .env 는 절대 GitHub 에 올리지 않습니다(.gitignore 가 막습니다).
# 앱에서 쓰는 키는 Windows 자격 증명 관리자(OS 보안 저장소)에 저장하는 것이 기본입니다. 환경변수는 개발·시험에서만 씁니다.
# 로그와 오류 보고서에는 이 값들을 출력하지 않습니다.

# 연결할 기존 chanceblog 로컬 저장소 폴더(키가 아니라 경로입니다)
CHANCEBLOG_LOCAL_REPO=

# (선택) 보조 AI — 비워 두면 보조 AI 기능은 꺼진 채로 모든 핵심 기능이 정상 동작합니다
GEMINI_API_KEY=

# (Blogger 연동을 쓸 때) 구글 Cloud 의 '데스크톱 앱' OAuth 클라이언트 — 블로그(영문·한글)마다 따로입니다
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# (선택) 글 이미지를 Unsplash 에서 고를 때
UNSPLASH_ACCESS_KEY=
